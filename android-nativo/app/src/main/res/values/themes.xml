<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JowyFit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.JowyFit.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.JowyFit</item>
    </style>
</resources>
