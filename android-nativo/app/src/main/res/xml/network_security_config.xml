<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prohibido HTTP sin cifrar en toda la app; solo se confía en certificados raíz del sistema. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
