{
  "name": "jowyfit",
  "private": true,
  "version": "0.6.0",
  "description": "App personal de entrenamiento de fuerza y recomposición corporal. Todo en local.",
  "author": "Jowy05",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "repdb": "node scripts/preparar-repdb.mjs",
    "iconos": "node scripts/iconos.mjs",
    "build:android": "tsc --noEmit -p tsconfig.json && vite build --mode android",
    "android": "npm run build:android && npx cap sync android",
    "e2e": "node scripts/e2e/correr.mjs --build",
    "e2e:dev": "node scripts/e2e/correr.mjs",
    "e2e:landing": "node scripts/e2e/landing.mjs --build",
    "e2e:iphone": "vite build --outDir .cache/dist-iphone --emptyOutDir && playwright test -c scripts/e2e-webkit/playwright.config.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-health": "^8.11.11",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "barcode-detector": "^3.2.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
